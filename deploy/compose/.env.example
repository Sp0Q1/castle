# Copy to .env and fill in. .env is git-ignored.

# The domain codenames live under. Subdomains are <codename>.$BASE_DOMAIN.
# Host names in this file are in ASCII: the xn-- form of a name with other
# letters.
BASE_DOMAIN=tenants.example.com

# The sign-in host (its own subdomain; Caddy obtains and renews its cert).
KC_HOST=sso.example.com
KC_PUBLIC_URL=https://sso.example.com

# Browser-facing port. Leave unset for prod (443). Set it when reaching the box
# on a non-443 port — e.g. an SSH tunnel to a machine where you can't bind 443:
#   ssh -L 8443:localhost:443 <box>   # then browse https://<host>:8443
# EXTERNAL_PORT=8443
# When EXTERNAL_PORT is a tunnel that doesn't exist on the box, castlectl still
# reaches Keycloak's admin API on the real local port via KC_ADMIN_URL:
# KC_ADMIN_URL=https://sso.example.com   # bare :443, where Caddy actually listens

# The sign-in host serves Keycloak's master realm, admin console and admin API
# only to requests that start on this server: castlectl, or your browser
# through an SSH tunnel (docs/admin-rotation.md). A tunnelled browser asks by
# name, so add the server's own public address for it to count as the server:
# KC_ADMIN_FROM="private_ranges 203.0.113.5"

# Keycloak first-boot admin. `castlectl keycloak-setup` gives castlectl an
# account of its own; then rotate to a named admin with TOTP and delete this
# one before real client data — see docs/admin-rotation.md.
KC_ADMIN_USER=admin
KC_ADMIN_PASS=change-me-strong

# Keycloak's database password.
KC_DB_PASSWORD=change-me-strong

# The castle image, built by CI with provenance and an SBOM. `:main` follows
# the main branch; `castlectl upgrade` resolves it to a digest for each run.
CASTLE_IMAGE=ghcr.io/sp0q1/castle:main

# The address of Caddy's ACME account, for the sign-in host's certificate.
ACME_EMAIL=ops@example.com

# The pool's certificates are dehydrated's, which has its own account address
# (CONTACT_EMAIL in dehydrated/config: see dehydrated/config.example). Override
# if your dehydrated binary/config live elsewhere:
# DEHYDRATED=dehydrated
# DEHYDRATED_CONFIG=./dehydrated/config
# DEHYDRATED_CERTDIR=./caddy/certs/_dehydrated

# Container engine: "docker" or "podman".
ENGINE=podman

# --- Self-hosted authoritative DNS ------------------------------------------
# When set, castle runs its own nameserver for $BASE_DOMAIN (the `dns` service,
# started with `--profile self-dns`): it publishes each provisioned codename's A
# record and drives dehydrated's DNS-01 challenge itself — no DNS-provider API
# key, and dark codenames leave no standing DNS record. Leave unset to manage DNS
# yourself elsewhere. Full setup (delegation, firewall): docs/self-hosted-dns.md.
# SELF_HOSTED_DNS=1
# PUBLIC_IP=203.0.113.10          # this VPS's public IP (A records + NS glue)
# DDNS_TSIG_SECRET=               # generate with: ./castlectl dns-init
# DNS_SERVER=127.0.0.1            # where castlectl sends dynamic updates (this box)
# DNS_PORT=53
# NS_NAME=ns1.example.com         # the nameserver's name when it is not ns1.$BASE_DOMAIN;
#                                 # read when the zone is first made

# --- backups (castlectl backup / restore) -----------------------------------
# Logical, encrypted backups that complement whole-box VPS snapshots. The box
# encrypts to a PUBLIC key and cannot read its own backups — decrypting needs the
# private identity you generate offline (`age-keygen`) and keep off the VPS.
# BACKUP_AGE_RECIPIENT=age1...     # public key — required to run `backup`
# `restore` and `import` read the private identity from BACKUP_AGE_IDENTITY.
# Give it in the shell for that one command and take the file away again: it
# does not belong in this file or on this server.
# BACKUP_DIR=./backups
# BACKUP_KEEP=14                   # prune to the newest N local bundles (0 = keep all)
# BACKUP_PUSH_CMD='rclone copy {} b2:castle-backups/'   # optional off-box copy ({} = bundle path)
# Schedule daily backups with the systemd timer in deploy/compose/systemd/
# (install steps: docs/backup-and-upgrade.md).

# LOCAL LAB ONLY, and on only when it is exactly 1: the pool's certificates are
# self-signed instead of issued, and the realm script accepts the sign-in
# host's self-signed certificate.
# KC_INSECURE=1
