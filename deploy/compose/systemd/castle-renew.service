[Unit]
Description=Castle pool certificate renewal (castlectl renew-pool)
Documentation=https://github.com/Sp0Q1/castle/blob/main/deploy/compose/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# castlectl sources ./.env itself, so it only needs the right cwd.
# Adjust the paths if you cloned somewhere other than /opt/castle.
WorkingDirectory=/opt/castle/deploy/compose
ExecStart=/opt/castle/deploy/compose/castlectl renew-pool
User=root
