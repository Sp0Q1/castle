# A codename's edge vhost — identical shape for a canary or a real tenant, so
# they are indistinguishable at the edge. castlectl substitutes __HOST__ and
# __CODENAME__ and writes this to caddy/sites/<codename>.caddy.
#
# The cert is pre-issued (bulk); Caddy serves it and never contacts the CA.
# The upstream (oauth2-proxy-<codename>) is the same container name whether this
# codename is a canary or a real tenant — only what sits BEHIND oauth2-proxy
# differs, which is invisible from here.
__HOST__ {
	# The access log is what a canary has to tell: nobody has an account there,
	# so whoever asks is worth a look. A tenant's vhost logs the same way.
	log
	tls /certs/__HOST__/fullchain.pem /certs/__HOST__/privkey.pem
	# The same headers on every answer of every codename, whatever is behind it:
	# the redirect to sign-in and the proxy's own pages carry them too, and a
	# tenant cannot be told from a canary by them. What says which software
	# answered is removed. The policy is the fallback for answers that bring
	# none; castle sends its own.
	header {
		Strict-Transport-Security "max-age=63072000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		?Content-Security-Policy "default-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		-Server
		-Via
		-X-Powered-By
	}
	# Signing out is something a person does by going there. A request a page
	# makes for an image, a font or a stylesheet is not that, whichever address
	# it names, so it is refused here, and nothing that someone wrote in a
	# finding signs its readers out. A browser that does not say what a request
	# is for is let through.
	@sign_out_for_a_page {
		path /oauth2/sign_out
		header Sec-Fetch-Dest *
		not header Sec-Fetch-Dest document
	}
	respond @sign_out_for_a_page 403
	reverse_proxy oauth2-proxy-__CODENAME__:4180 {
		# oauth2-proxy runs with --reverse-proxy and believes these two. Caddy
		# sets Host, Proto and For itself; these it would pass on as the
		# visitor sent them.
		header_up -X-Forwarded-Uri
		header_up X-Real-IP {remote_host}
	}
}
