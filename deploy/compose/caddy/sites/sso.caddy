# The IdP vhost. Unlike the codename pool (which pins pre-issued certs), the IdP
# is always-on and not a decoy, so Caddy manages its cert itself via ACME
# (HTTP-01 / TLS-ALPN-01) over its permanent listeners and renews it
# automatically — no dehydrated, no pre-issue, no manual step.
# {$SSO_HOST} is KC_HOST of .env, substituted when Caddy starts.
{$SSO_HOST} {
	log   # login attempts hit /realms/<realm>/login-actions/authenticate here
	# Keycloak sends its own security headers; only what names the software goes.
	header {
		-Server
		-Via
	}
	# To the world this host is for signing in: the pool's realms and Keycloak's
	# static files. The rest of Keycloak (the master realm, the admin console,
	# the admin API) answers only a request that starts on this server, which
	# is how castlectl asks, and how an administrator's browser arrives through
	# an SSH tunnel. Anyone else gets 404 for it.
	@signin {
		path /realms/{$SSO_REALM_PREFIX:castle-}* /resources/* /robots.txt
		not path /realms/master /realms/master/*
	}
	@here remote_ip {$SSO_ADMIN_FROM:private_ranges}
	handle @signin {
		reverse_proxy keycloak:8080
	}
	handle @here {
		reverse_proxy keycloak:8080
	}
	handle {
		respond 404
	}
}
