#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# castlectl — runs castle on a single VPS with Podman or Docker Compose and
# Caddy: a pool of codenames, each with its own Keycloak realm and its own
# secrets, and nothing on the host that says which client a codename is.
#
#   castlectl issue-certs [N]       issue certificates for N more codenames in
#                                   one batch. Needs no Keycloak; with the
#                                   bundled nameserver it needs that one running
#                                   (docs/self-hosted-dns.md).
#   castlectl provision-pool        stand up a canary for every codename that has
#                                   a cert but no instance (platform must be up)
#   castlectl renew-pool            renew what is due in the pool, in one run
#                                   (systemd/castle-renew.timer asks weekly)
#   castlectl allocate              pick a free codename, issue its cert, canary it
#   castlectl promote <codename>    turn a canary into a real tenant (no new cert)
#   castlectl demote <codename> --yes
#                                   export a tenant, then turn it back into a
#                                   canary: data, people and secrets go, cert stays
#   castlectl export <codename>     one tenant's data and people as a bundle
#   castlectl import <file> <codename>
#                                   load a tenant bundle into a canary
#   castlectl users <codename>      who is in a codename's realm, and as what
#   castlectl keycloak-setup        give castlectl an account of its own at
#                                   Keycloak (docs/admin-rotation.md)
#   castlectl deprovision <codename>
#   castlectl list
#   castlectl status              how this server is, as JSON for the overview
#                                   (docs/status.md)
#   castlectl upgrade [<codename>]  recreate running instances from the templates
#   castlectl backup | restore      an encrypted bundle of everything not re-derivable
#   castlectl dns-init | dns-sync   the bundled nameserver's key and records
#
# Bring-up: deploy/compose/README.md has the order, which depends on who
# serves DNS for the pool.
#
# THE CERT STRATEGY: certs for the whole pool are issued once, together, and
# every pool vhost pins its own — so promoting a canary to a real tenant
# contacts no CA and leaves no Certificate Transparency trace. An observer sees
# the pool issued in bulk and never learns which codenames became real, or when.
#
# CODENAME-ONLY: no client name is ever taken or stored. You record which client
# a codename belongs to in your own store, off this host.
# ---------------------------------------------------------------------------
# castlectl is run. Read into a shell with `source`, it would leave that shell
# with what is set below.
(return 0 2>/dev/null) && { echo "castlectl: run it as ./castlectl <command>" >&2; return 1; }
set -uo pipefail
# What this writes is secrets, rendered files that name them, and bundles:
# for the user who runs it and nobody else.
umask 077
# A cd goes where it is told and prints nothing, whatever the caller's CDPATH.
unset CDPATH
# Defined first so that the lines below can use it: a function isn't callable
# before the line that defines it runs.
die(){ echo "castlectl: $*" >&2; exit 1; }
# The deployment is the directory this file lies in, by whatever path or link
# it was called. Text handed to bash without a file has no such place.
SELF="$(realpath -e -- "${BASH_SOURCE[0]:-}" 2>&1)" || die "run it as ./castlectl <command>"
HERE="$(dirname -- "$SELF")"
cd "$HERE" || die "cannot cd to $HERE"
# The caller's standard input is not castlectl's: what is started below is
# handed a file, or reads an empty one.
exec </dev/null || die "cannot open /dev/null"
# A fresh host has no .env: it is in the bundle being restored. Take it from
# there first, so that everything below finds its configuration.
if [[ "${1:-}" == restore && ! -f .env && -f "${2:-}" && "${3:-}" == --yes ]]; then
  [[ -n "${BACKUP_AGE_IDENTITY:-}" ]] || die "set BACKUP_AGE_IDENTITY (age identity file) to decrypt"
  ( umask 077; age -d -i "$BACKUP_AGE_IDENTITY" < "$2" | tar xf - -O ./platform/env > .env ) && [[ -s .env ]] \
    || { rm -f .env; die "no .env on this host and none in $2 — write one from .env.example first"; }
  echo "restore: took .env from the bundle"
fi
[[ -f .env ]] && set -a && . ./.env && set +a
# In every shape below a letter is one of a to z and a digit one of 0 to 9, and
# the tools called from here sort and print alike, whatever locale and shell
# options the caller brought along.
export LC_ALL=C
shopt -u nocasematch

POOL="${POOL:-$HERE/codenames.txt}"
REALM_SH="${REALM_SH:-$HERE/keycloak-realm.sh}"
TPL="$HERE/templates"
SITES="$HERE/caddy/sites"
CERTS="$HERE/caddy/certs"
RUN="$HERE/.instances"                        # per-codename generated compose files
# Files from before the umask above are closed as well.
[[ -d "$RUN" ]] && chmod -R go= "$RUN"
[[ -f .env ]] && chmod go= .env
BASE_DOMAIN="${BASE_DOMAIN:?set BASE_DOMAIN in .env}"
KC_PUBLIC_URL="${KC_PUBLIC_URL:?set KC_PUBLIC_URL in .env}"
# The sign-in host's bare name, which the platform's Caddy serves. Asked for
# here as well, so a .env without it stops castlectl before it stops Caddy.
KC_HOST="${KC_HOST:?set KC_HOST in .env (IdP hostname, e.g. sso.example.com)}"
# Where castlectl reaches Keycloak's admin API: the sign-in host (or
# KC_ADMIN_URL, when the browser-facing port is not the one this server listens
# on), asked on the server's own loopback. The name and its certificate are
# still the ones checked, and the request starts here, which is what the
# sign-in host's vhost asks of anything but signing in (caddy/sites/sso.caddy).
# An empty KC_RESOLVE asks by name instead.
KC_ADMIN_URL="${KC_ADMIN_URL:-$KC_PUBLIC_URL}"
admin_at="${KC_ADMIN_URL#*://}"; admin_at="${admin_at%%/*}"
case "$admin_at" in
  *:*) admin_at="${admin_at%%:*}:${admin_at##*:}" ;;
  *)   admin_at="$admin_at:443" ;;
esac
export KC_RESOLVE="${KC_RESOLVE-$admin_at:127.0.0.1}"
# The secret of castlectl's own account at Keycloak, once `keycloak-setup` has
# made it. With it, that account is who asks, and no administrator's password
# is needed here.
KC_SERVICE="$RUN/_keycloak.secret"
if [[ -s "$KC_SERVICE" ]]; then
  KC_CLIENT_SECRET="$(cat "$KC_SERVICE")"
  export KC_CLIENT_ID=castlectl KC_CLIENT_SECRET
fi
KC_REALM_PREFIX="${KC_REALM_PREFIX:-castle-}"
[[ "$KC_REALM_PREFIX" =~ ^[a-z][a-z0-9-]{0,30}$ ]] || die "KC_REALM_PREFIX in .env is lower-case letters, digits and hyphens, a letter first"
CASTLE_IMAGE="${CASTLE_IMAGE:?set CASTLE_IMAGE in .env}"
ENGINE="${ENGINE:-podman}"
COMPOSE="${COMPOSE:-$ENGINE compose}"
# Cert issuance is dehydrated's. castlectl maintains DOMAINS_TXT (the pool) and
# collects the results; dehydrated's config says how the challenge is answered
# (a DNS-01 hook) and where certificates land.
DEHYDRATED="${DEHYDRATED:-dehydrated}"
DEHYDRATED_CONFIG="${DEHYDRATED_CONFIG:-$HERE/dehydrated/config}"
DEHYDRATED_CERTDIR="${DEHYDRATED_CERTDIR:-$CERTS/_dehydrated}"
DOMAINS_TXT="$RUN/domains.txt"                # dehydrated's domains.txt = the allocated pool

EXTERNAL_PORT="${EXTERNAL_PORT:-}"   # port in browser-facing URLs (blank = 443)

# --- self-hosted authoritative DNS ----------------------------------------
# When SELF_HOSTED_DNS is set, castle runs its own nameserver for $BASE_DOMAIN
# (the `dns` service in platform.compose.yml). castlectl then publishes each
# provisioned codename's A record and drives DNS-01 through it, both via RFC 2136
# dynamic updates (nsupdate + a TSIG key). Unset -> castlectl never touches DNS.
SELF_HOSTED_DNS="${SELF_HOSTED_DNS:-}"
PUBLIC_IP="${PUBLIC_IP:-}"                       # VPS public IP for A records
DNS_SERVER="${DNS_SERVER:-127.0.0.1}"            # where nsupdate sends (this box)
DNS_PORT="${DNS_PORT:-53}"
TSIG_NAME="${TSIG_NAME:-castle-ddns}"
TSIG_ALGO="${TSIG_ALGO:-hmac-sha256}"
TSIG_KEYFILE="${TSIG_KEYFILE:-$RUN/ddns.key}"    # nsupdate key, derived from .env

# --- backups ---------------------------------------------------------------
# Logical, encrypted backups (complement to whole-box VPS snapshots): each
# tenant's DB + uploads + secrets + certs, bundled and age-encrypted to a public
# key, so the box can WRITE backups but can't read them back — decrypting needs
# the identity you keep offline. Restore uses BACKUP_AGE_IDENTITY.
BACKUP_DIR="${BACKUP_DIR:-$HERE/backups}"
BACKUP_AGE_RECIPIENT="${BACKUP_AGE_RECIPIENT:-}"   # age public key (age1…) — required to back up
BACKUP_AGE_IDENTITY="${BACKUP_AGE_IDENTITY:-}"     # age identity file — required to restore
BACKUP_KEEP="${BACKUP_KEEP:-14}"                   # keep this many local bundles (0 = keep all)
BACKUP_PUSH_CMD="${BACKUP_PUSH_CMD:-}"             # optional off-box copy per bundle ({} = its path)
# postgres:18-alpine is already pinned by the deployment, so reuse it as the
# utility image for tar-ing volumes (busybox tar) — no extra image to pull.
UTIL_IMAGE="${UTIL_IMAGE:-docker.io/library/postgres:18-alpine}"

need(){ command -v "$1" >/dev/null 2>&1 || die "$1 is required but not on PATH"; }
# One writer of bundles at a time: `backup` and `export` hold this lock for as
# long as they run, and a second one says so and stops. Whoever holds it is the
# only writer, so a `.part` it finds was left by a run that did not end, and
# goes. The lock is the kernel's, on an open file: it ends with the process.
BUNDLE_LOCK=""
bundle_lock(){
  [[ -z "$BUNDLE_LOCK" ]] || return 0
  need flock
  mkdir -p "$BACKUP_DIR" || die "cannot make $BACKUP_DIR"
  exec {BUNDLE_LOCK}> "$BACKUP_DIR/.lock" || die "cannot write in $BACKUP_DIR"
  flock -n "$BUNDLE_LOCK" || die "another backup or export is writing to $BACKUP_DIR: let it end first"
  rm -f "$BACKUP_DIR"/*.tar.age.part
}
# A directory for what must not outlive the command: database dumps, an opened
# bundle. It is removed when the shell that asked for it ends, whichever way
# that is: on a return, on `die`, on a signal. The trap is set here and not
# once at the top because a subshell starts without its parent's traps.
WORK=()
remove_work(){ [[ ${#WORK[@]} -eq 0 ]] || rm -rf "${WORK[@]}"; }
workdir(){ # <name of the variable that gets the path>
  local -n into="$1"
  into="$(mktemp -d)" || die "could not make a work directory"
  WORK+=("$into"); trap remove_work EXIT
}
# Run a command silently on success and, on failure, die with its output, so
# the operator sees the actual cause (a failed pull, a compose conflict). (Only
# for commands with no leading VAR=val env prefix, which `"$@"` can't carry.)
run_or_die(){ # <what> <cmd> [args...]
  local what="$1"; shift
  local out
  out="$("$@" 2>&1)" || die "$what:"$'\n'"$out"
}
# Batch failure policy shared by upgrade/backup/restore: none may abort the whole
# fleet on the first bad item — each collects failures in a local array, keeps
# going, and ends here. Prints an "ok/total" summary (failures to stderr) and
# returns 1 iff anything failed, so the caller can still run its final steps
# (reload_caddy, retention) and only then exit nonzero.
batch_result(){ # <label> <total> [<failure>...]
  local label="$1" total="$2"; shift 2
  local failed=$#
  if (( failed > 0 )); then
    echo "$label: $((total - failed))/$total ok, $failed failed:" >&2
    printf '  - %s\n' "$@" >&2
    return 1
  fi
  echo "$label: $total/$total ok."
}
# A literal newline, so "${out##*"$NL"}" can trim captured output to its last line
# (usually the error) for a concise failure summary.
NL=$'\n'
# Bare host — for certs, DNS and Caddy vhost names (no port; a cert is for a
# host, not a host:port).
host_of(){ echo "$1.$BASE_DOMAIN"; }
# Host with the browser-facing port — for OIDC redirect URIs and any URL a
# browser follows. Equal to host_of when EXTERNAL_PORT is unset (prod, 443).
hostport_of(){ echo "$1.$BASE_DOMAIN${EXTERNAL_PORT:+:$EXTERNAL_PORT}"; }
realm_of(){ echo "${KC_REALM_PREFIX}$1"; }
rand(){ openssl rand -base64 "${1:-32}" | tr -d '\n'; }
proj_of(){ echo "castle-$1"; }
# The volumes of a codename's project: a tenant's database and uploads.
volumes_of(){ "$ENGINE" volume ls --format '{{.Name}}' | grep -E "^$(proj_of "$1")_" || true; }
mkdir -p "$RUN"

pool_codenames(){ grep -vE '^\s*(#|$)' "$POOL"; }

# SOURCE OF TRUTH = the runtime + the artifacts on disk, never a bookkeeping
# file that could drift from them:
#   - a codename HAS a cert if its cert file exists (the artifact);
#   - it's RUNNING as a tenant/canary if its containers exist (ask the engine).
# The only things genuinely stored are what cannot be re-derived: the per-codename
# secrets and the certs themselves. domains.txt is just dehydrated's INPUT list
# (what to issue), not a claim about what exists.
has_cert(){ [[ -f "$CERTS/$(host_of "$1")/fullchain.pem" ]]; }
# One lookup per container, not a parse of `ps -a`: a listing can come back
# empty for a moment while an `upgrade` recreates many containers at once, and
# an empty listing reads as "not there". `container exists` (podman) /
# `container inspect` (docker) answers 0 or 1 for a single name.
container_exists(){
  if [[ "$ENGINE" == *podman ]]; then "$ENGINE" container exists "$1"
  else "$ENGINE" container inspect "$1" >/dev/null 2>&1; fi
}
kind_of(){ # tenant | canary | "" — derived from the engine, not a local file
  container_exists "castle-$1" && { echo tenant; return; }
  container_exists "oauth2-proxy-$1" && { echo canary; return; }
  echo ""
}
# next_codename must skip a name that already owns a cert OR is queued for one.
taken(){ has_cert "$1" || grep -qxF "$(host_of "$1")" "$DOMAINS_TXT" 2>/dev/null; }
allocated(){ local cn; for cn in $(pool_codenames); do taken "$cn" && echo "$cn"; done; }
add_domain(){ mkdir -p "$RUN"; touch "$DOMAINS_TXT"; grep -qxF "$1" "$DOMAINS_TXT" || echo "$1" >> "$DOMAINS_TXT"; }

next_codename(){
  local free; free="$(comm -23 <(pool_codenames | sort) <(allocated | sort))"
  [[ -n "$free" ]] || die "codename pool exhausted — add names to $(basename "$POOL")"
  echo "$free" | shuf -n 1
}

# --- self-hosted DNS ------------------------------------------------------
# The nsupdate key file is derived from DDNS_TSIG_SECRET in .env — the SAME
# secret the `dns` service loads — so both sides share one key. Written 0600 and
# never committed (it lives under .instances/, which is git-ignored).
ensure_tsig_keyfile(){
  [[ -n "${DDNS_TSIG_SECRET:-}" ]] || die "SELF_HOSTED_DNS set but DDNS_TSIG_SECRET missing in .env (run: castlectl dns-init)"
  [[ -f "$TSIG_KEYFILE" ]] && return 0
  ( umask 077
    printf 'key "%s" {\n    algorithm %s;\n    secret "%s";\n};\n' \
      "$TSIG_NAME" "$TSIG_ALGO" "$DDNS_TSIG_SECRET" > "$TSIG_KEYFILE" )
}
# Send RFC 2136 update commands (on stdin) to our authoritative server.
dns_nsupdate(){
  nsupdate -k "$TSIG_KEYFILE" <<EOF
server $DNS_SERVER $DNS_PORT
zone $BASE_DOMAIN.
$(cat)
send
EOF
}
dns_set_a(){ # <codename> — point the codename at this box (idempotent)
  [[ -n "$SELF_HOSTED_DNS" ]] || return 0
  need nsupdate; ensure_tsig_keyfile
  [[ -n "$PUBLIC_IP" ]] || die "SELF_HOSTED_DNS set but PUBLIC_IP missing in .env"
  local host; host="$(host_of "$1")"
  printf 'update delete %s. A\nupdate add %s. 300 A %s\n' "$host" "$host" "$PUBLIC_IP" \
    | dns_nsupdate || die "nsupdate A for $host failed"
}
dns_del_a(){ # <codename> — remove the A record (goes dark)
  [[ -n "$SELF_HOSTED_DNS" ]] || return 0
  need nsupdate; ensure_tsig_keyfile
  local host; host="$(host_of "$1")"
  printf 'update delete %s. A\n' "$host" | dns_nsupdate || true
}

# --- certificates ---------------------------------------------------------
# One batch over the WHOLE pool (domains.txt), not per-host: dehydrated issues
# the missing certs and renews the near-expiry ones together, which is exactly
# the "one CA event, one CT batch, synchronized renewal" property. This is the
# only place a cert is ever obtained, and promoting a canary never re-enters it.
# Your dehydrated config owns the challenge type + CERTDIR; castlectl only
# supplies the domains and copies the results into Caddy's cert dir.
sync_certs(){
  touch "$DOMAINS_TXT"
  if [[ "${KC_INSECURE:-0}" == "1" ]]; then     # lab: self-signed, never touch a CA
    while read -r host; do [[ -n "$host" ]] && mock_cert "$host"; done < "$DOMAINS_TXT"
    return
  fi
  need "$DEHYDRATED"
  # With self-hosted DNS, dehydrated's DNS-01 hook (dns-hook.sh) talks to our own
  # nameserver over nsupdate; export the key + server it needs so the hook (a
  # dehydrated subprocess) inherits them. (An array of VAR=val can't be used as a
  # command's env-assignment prefix — bash only honours literal assignments.)
  if [[ -n "$SELF_HOSTED_DNS" ]]; then
    ensure_tsig_keyfile
    export DNS_SERVER DNS_PORT TSIG_KEYFILE
  fi
  # dehydrated reads its DOMAINS_TXT + CERTDIR from the config file (see
  # dehydrated/config.example); castlectl passes the same DOMAINS_TXT via env so
  # the config can point at it. -c = cron mode: issue missing + renew due, all
  # in one run. --keep-going: a name that fails does not stop the names after
  # it, and the run ends non-zero.
  # Ensure the ACME account exists (idempotent; per-CA, so this covers both the
  # staging and prod accounts the first time each is used) — otherwise dehydrated
  # aborts asking you to accept the CA's terms.
  local failed=0 host
  "$DEHYDRATED" ${DEHYDRATED_CONFIG:+-f "$DEHYDRATED_CONFIG"} --register --accept-terms >/dev/null 2>&1 || true
  DOMAINS_TXT="$DOMAINS_TXT" CERTDIR="$DEHYDRATED_CERTDIR" \
    "$DEHYDRATED" ${DEHYDRATED_CONFIG:+-f "$DEHYDRATED_CONFIG"} -c --keep-going ${DEHYDRATED_ARGS:-} \
    || failed=1
  # Every certificate dehydrated holds goes to where Caddy reads it, also after
  # a run in which a name failed.
  while read -r host; do
    [[ -n "$host" && -f "$DEHYDRATED_CERTDIR/$host/fullchain.pem" ]] || continue
    install -m600 -D "$DEHYDRATED_CERTDIR/$host/fullchain.pem" "$CERTS/$host/fullchain.pem"
    install -m600 -D "$DEHYDRATED_CERTDIR/$host/privkey.pem"  "$CERTS/$host/privkey.pem"
  done < "$DOMAINS_TXT"
  return "$failed"
}
# What Caddy serves for the pool, one line per certificate.
served_certs(){
  local host
  while read -r host; do
    [[ -n "$host" && -f "$CERTS/$host/fullchain.pem" ]] && sha256sum "$CERTS/$host/fullchain.pem"
  done < "$DOMAINS_TXT"
  return 0
}

# Lab-only self-signed stand-in so the whole flow is testable without a CA.
mock_cert(){ # <host>
  local host="$1"; local d="$CERTS/$host"; mkdir -p "$d"
  openssl req -x509 -newkey rsa:2048 -nodes -keyout "$d/privkey.pem" \
    -out "$d/fullchain.pem" -days 90 -subj "/CN=$host" \
    -addext "subjectAltName=DNS:$host" >/dev/null 2>&1
}

# --- Caddy vhosts ---------------------------------------------------------
write_site(){ # <codename>
  local cn="$1" host; host="$(host_of "$cn")"
  sed -e "s/__HOST__/$host/g" -e "s/__CODENAME__/$cn/g" \
    "$TPL/site.caddy" > "$SITES/$cn.caddy"
}
reload_caddy(){ $COMPOSE -f platform.compose.yml exec -T caddy caddy reload --config /etc/caddy/Caddyfile 2>/dev/null \
  || $COMPOSE -f platform.compose.yml restart caddy >/dev/null 2>&1 || true; }

# --- provision a canary / tenant -----------------------------------------
# Only STRUCTURAL placeholders are sed'd in (codename/realm/host/image — all safe
# chars). Secrets are NOT written into the rendered file; they are injected from
# the environment at compose time (compose_instance), so base64 `/`/`+` never
# breaks sed and no secret lands on disk in a compose file.
render_instance(){ # <codename> <template> [<image>]  (image defaults to $CASTLE_IMAGE)
  local cn="$1" tpl="$2" img="${3:-$CASTLE_IMAGE}"
  local realm host hostport
  realm="$(realm_of "$cn")"; host="$(host_of "$cn")"; hostport="$(hostport_of "$cn")"
  # __IMAGE__ uses '#' as the sed delimiter, so the image ref (which contains '/'
  # and, for a digest, '@' and ':' — but never '#') needs no escaping.
  sed -e "s/__CODENAME__/$cn/g" -e "s/__REALM__/$realm/g" -e "s#__HOST__#$host#g" \
      -e "s#__HOSTPORT__#$hostport#g" \
      -e "s#__KC_PUBLIC__#$KC_PUBLIC_URL#g" -e "s#__IMAGE__#${img}#g" \
      -e "s#__BRANDING__#$HERE/branding#g" \
      "$tpl" > "$RUN/$cn.compose.yml"
}

# Resolve an image ref to its immutable repo@sha256 form (the image must be local
# first — pull it; prints nothing if it isn't present). A moving tag like :main
# keeps the same string while the digest it points at changes underneath, so
# `up -d` sees no change to the rendered compose and leaves the old container
# running. Rendering pinned to the resolved digest makes the reference change
# when the image does, so a moved tag is redeployed: podman-compose then
# recreates the tenant's project, proxy and database included, and the data
# volumes stay.
resolve_digest(){ # <image-ref>  ->  <repo>@sha256:...
  $ENGINE image inspect --format '{{if .RepoDigests}}{{index .RepoDigests 0}}{{end}}' "$1" 2>/dev/null
}

# The reference a container is actually running, so `upgrade` reports whether
# anything moved. A CASTLE_IMAGE pinned to a digest keeps a tenant on that
# build, and the report says so.
running_ref(){ # <container> -> <image ref it was created from>
  $ENGINE inspect --format '{{.ImageName}}' "$1" 2>/dev/null
}

# A short, readable form of an image reference for the upgrade report. Tenants
# are normally rendered pinned to a digest, but one first created by `promote`
# while CASTLE_IMAGE was a tag is running from that tag — so fall back to the
# reference itself rather than printing twelve characters of "ghcr.io/...".
short_ref(){ # <image-ref> -> 12 chars of its digest, or the ref if it has none
  case "$1" in
    *@sha256:*) printf '%.12s' "${1##*@sha256:}" ;;
    *)          printf '%s' "$1" ;;
  esac
}

# The deployment's own logo: a file named `logo` in branding/, as castle sees it.
logo(){ [[ -f "$HERE/branding/logo" ]] && echo /app/branding/logo; }
# Castle does not run as root, so it reads the logo as anybody on the host
# would. Asked before a tenant is touched: a castle that is given a logo it
# cannot read does not start.
check_logo(){
  [[ -f "$HERE/branding/logo" ]] || return 0
  [[ "$(stat -Lc %a "$HERE/branding")" == *[1357] && "$(stat -Lc %a "$HERE/branding/logo")" == *[4567] ]] \
    || die "branding/logo is not readable by everyone, and castle does not run as root. Run: chmod 755 branding && chmod 644 branding/logo"
}

# Run a compose command for a codename with its secrets exported, so compose
# substitutes ${OAP_*}/${CASTLE_*} from the environment. The DB password is hex
# (URL-safe in DATABASE_URL); JWT stays base64 (loco decodes it).
compose_instance(){ # <codename> <compose args...>
  local cn="$1"; shift
  OAP_CLIENT_SECRET="$(secret_for "$cn")" \
  OAP_COOKIE_SECRET="$(cookie_for "$cn")" \
  CASTLE_JWT="$(ensure_secret "$cn" jwt 48)" \
  CASTLE_DB_PW="$(ensure_secret "$cn" db 24 hex)" \
  CASTLE_UPSTREAM_SECRET="$(ensure_secret "$cn" upstream 32 hex)" \
  CASTLE_LOGO="$(logo)" \
    $COMPOSE -p "$(proj_of "$cn")" -f "$RUN/$cn.compose.yml" "$@"
}

provision_canary(){ # <codename>
  local cn="$1" rerr
  [[ "$cn" =~ ^[a-z][a-z0-9-]{1,30}$ ]] || die "invalid codename '$cn'"
  echo "canary '$cn' -> https://$(host_of "$cn")"
  # A canary realm: created empty (keycloak-realm.sh makes users:[]), events on.
  # Capture the realm script's output so a failure surfaces WHY (admin auth, an
  # HTTP error) instead of a bare "realm create failed". Env prefix -> inline
  # capture, since run_or_die's "$@" can't carry VAR=val assignments.
  rerr="$(KC_URL="$KC_ADMIN_URL" KC_REALM_PREFIX="$KC_REALM_PREFIX" BASE_DOMAIN="$BASE_DOMAIN" EXTERNAL_PORT="$EXTERNAL_PORT" \
    CLIENT_SECRET="$(secret_for "$cn")" "$REALM_SH" create "$cn" 2>&1)" \
    || die "realm create failed for $cn:"$'\n'"$rerr"
  render_instance "$cn" "$TPL/canary.compose.yml"
  write_site "$cn"
  run_or_die "compose up failed for $cn" compose_instance "$cn" up -d
  dns_set_a "$cn"     # publish the A record (no-op unless SELF_HOSTED_DNS)
  echo "  ok (canary)"
}

# Per-codename secrets are generated once and cached, so the realm's client
# secret and the oauth2-proxy's stay in lockstep across canary<->tenant swaps.
secret_for(){ ensure_secret "$1" client 32; }
cookie_for(){ ensure_secret "$1" cookie 16 hex; }
ensure_secret(){ # <codename> <name> <bytes> [hex]
  local f="$RUN/$1.$2"; [[ -s "$f" ]] && { cat "$f"; return; }
  local v; if [[ "${4:-}" == hex ]]; then v="$(openssl rand -hex "$3")"; else v="$(rand "$3")"; fi
  [[ -n "$v" ]] || die "openssl made no $2 secret for '$1'"
  printf '%s' "$v" > "$f"; printf '%s' "$v"
}

# --- commands -------------------------------------------------------------
# What the steps of a command run with. A command asks at its top for the
# steps it reaches, and so names a missing tool before it has changed anything.
need_keycloak(){ need jq; need curl; }                        # keycloak-realm.sh, which asks for both itself
need_dns(){ [[ -z "$SELF_HOSTED_DNS" ]] || need nsupdate; }   # dns_set_a, dns_del_a
# sync_certs: dehydrated, and with the bundled nameserver what its hook runs.
need_issuer(){ [[ "${KC_INSECURE:-0}" == "1" ]] || { need "$DEHYDRATED"; need_dns; [[ -z "$SELF_HOSTED_DNS" ]] || need dig; }; }
need_export(){ need age; need_keycloak; need "$ENGINE"; need tar; need flock; }   # export_tenant

# The single controlled CA interaction: issue the IdP cert + N codename certs in
# one batch. No Keycloak or platform required — this runs first, so the certs
# exist before Caddy starts. CT shows them appearing together.
issue_certs(){ # [N]
  need openssl; need_issuer
  local n="${1:-10}" cn picked=()
  # The pool only. The sign-in host's certificate is Caddy's to obtain and
  # renew, over its own listeners (caddy/sites/sso.caddy).
  echo "adding $n codenames to the pool, then one batch issuance"
  for _ in $(seq 1 "$n"); do
    cn="$(next_codename)"; picked+=("$cn")   # next_codename skips names already in the pool
    add_domain "$(host_of "$cn")"
  done
  sync_certs || die "dehydrated failed for at least one of: ${picked[*]}. The next issue-certs or renew-pool tries again"
  echo "issued for: ${picked[*]}"
  echo "next: 'castlectl provision-pool', once the platform is up"
}

# Stand up a canary for every codename that has a cert but isn't provisioned yet.
# Idempotent — safe to re-run. Platform (Keycloak) must be up.
provision_pool(){
  need_keycloak; need openssl; need_dns
  local done_any=0 cn
  # Every codename that has a cert but isn't running yet -> stand up a canary.
  for cn in $(pool_codenames); do
    has_cert "$cn" || continue
    [[ -n "$(kind_of "$cn")" ]] && continue      # already running (asked the engine)
    # A canary starts with its realm, and Keycloak takes a minute to answer
    # after the platform is started.
    [[ "$done_any" == 1 ]] || realm_sh await || die "Keycloak does not answer at $KC_ADMIN_URL: is the platform up?"
    provision_canary "$cn"; done_any=1
  done
  [[ "$done_any" == 1 ]] && reload_caddy
  echo "pool provisioned."
}

renew_pool(){
  need_issuer
  echo "renewing what is due in the pool (one dehydrated run)"
  touch "$DOMAINS_TXT"
  local before failed=0
  before="$(served_certs)"
  sync_certs || failed=1      # dehydrated -c renews everything in domains.txt that's due
  # Caddy reads a certificate when it starts, so it is restarted when one
  # changed, and left alone otherwise.
  if [[ "$(served_certs)" == "$before" ]]; then
    echo "no certificate changed."
  else
    reload_caddy
    echo "renewed."
  fi
  [[ "$failed" == 0 ]] || die "dehydrated failed for at least one name; what it did renew is served"
}

promote(){ # <codename>
  local cn="${1:?promote needs a <codename>}"
  [[ "$(kind_of "$cn")" == canary ]] || die "'$cn' is not a canary"
  need openssl
  check_logo
  echo "promoting canary '$cn' -> real tenant (cert + subdomain + realm unchanged)"
  compose_instance "$cn" down >/dev/null 2>&1
  render_instance "$cn" "$TPL/tenant.compose.yml"
  run_or_die "compose up failed for $cn" compose_instance "$cn" up -d
  echo "  ok (tenant) — now add the client's users to realm $(realm_of "$cn")"
}

# Back to a canary like any other: the data, the people in the realm and the
# codename's secrets all go, so nothing of the client is left and no session of
# theirs survives. Only the cert and the name stay. A tenant bundle is written
# first; every step that can refuse does so before anything is destroyed, and a
# run that stopped half-way can be repeated.
demote(){ # <codename> --yes [--no-export]
  local cn="${1:?demote needs a <codename>}" yes="" keep=1 arg; shift
  for arg in "$@"; do
    case "$arg" in --yes) yes=1 ;; --no-export) keep="" ;; *) die "demote: unknown option '$arg'" ;; esac
  done
  [[ "$(kind_of "$cn")" == tenant ]] || die "'$cn' is not a tenant"
  [[ -n "$yes" ]] || die "demote destroys the data, the people and the secrets of '$cn' — re-run with --yes to confirm"
  need_keycloak; need openssl; need_dns
  [[ -z "$keep" ]] || need_export
  compose_instance "$cn" stop castle >/dev/null 2>&1      # nobody writes from here on
  if [[ -n "$keep" ]] && ! (export_tenant "$cn"); then
    compose_instance "$cn" start castle >/dev/null 2>&1
    die "export failed — nothing was destroyed (use --no-export to demote without one)"
  fi
  if ! realm_sh delete "$cn"; then
    compose_instance "$cn" start castle >/dev/null 2>&1
    die "could not delete the realm of '$cn' — nothing was destroyed"
  fi
  echo "demoting tenant '$cn' -> canary (cert kept; data, people and secrets are destroyed)"
  compose_instance "$cn" down -v >/dev/null 2>&1
  rm -f "$RUN/$cn".{client,cookie,jwt,db,upstream}
  provision_canary "$cn"; reload_caddy
  # "Destroyed" is said when it is so. The codename answers as a canary again
  # either way, so it does not go dark; a volume that `down -v` left behind is
  # the client's data, and this ends by naming it.
  local left; left="$(volumes_of "$cn")"
  [[ -z "$left" ]] || die "'$cn' is a canary again, but its data is still on this host. Remove it: $ENGINE volume rm ${left//$'\n'/ }"
}

deprovision(){ # <codename>
  local cn="${1:?deprovision needs a <codename>}"
  # Validate before $cn reaches `rm -f` below (same regex provision_canary uses):
  # an unchecked codename with a slash or glob could delete outside its own files.
  [[ "$cn" =~ ^[a-z][a-z0-9-]{1,30}$ ]] || die "invalid codename '$cn'"
  [[ "$(kind_of "$cn")" != tenant ]] || die "'$cn' is a tenant — demote it first"
  need_keycloak; need_dns
  local out left=""
  echo "deprovisioning '$cn'"
  [[ -f "$RUN/$cn.compose.yml" ]] && compose_instance "$cn" down -v >/dev/null 2>&1
  dns_del_a "$cn"     # withdraw the A record (no-op unless SELF_HOSTED_DNS)
  out="$(realm_sh delete "$cn" 2>&1)" || left="${out##*"$NL"}"
  rm -f "$SITES/$cn.caddy" "$RUN/$cn".{compose.yml,client,cookie,jwt,db,upstream}
  reload_caddy
  [[ -z "$left" ]] || die "'$cn' is removed here, and its realm is still in Keycloak — $left. Run this again when Keycloak answers"
  echo "  removed (cert left in place for reuse)"
}

list(){
  printf '%-16s %-9s %s\n' CODENAME STATE URL
  # Reflect reality: a codename appears if it's running (engine) or has a cert.
  local cn state
  for cn in $(pool_codenames); do
    state="$(kind_of "$cn")"
    if [[ -z "$state" ]]; then has_cert "$cn" && state="cert-only" || continue; fi
    printf '%-16s %-9s %s\n' "$cn" "$state" "https://$(host_of "$cn")"
  done
}

# --- status ----------------------------------------------------------------
# How this server is, as one JSON document for the overview (docs/status.md).
# What is gathered here goes, one line for each thing, to status.jq, which
# makes the document and holds every value to what a status has there. What
# could not be read is empty here and null there, never a value that reads as
# fine. Every question to the engine or to systemd is given a time to answer.

# Whether a container is there. An engine that does not say is not taken for
# "no": where status_lines asks, which decides what a codename is, that ends
# the run; inside a `$(...)`, as in state_of, it ends that one question, whose
# value is then empty and null in the document.
there(){ # <container>
  local code=0 said
  if [[ "$ENGINE" == *podman ]]; then
    timeout 20 "$ENGINE" container exists "$1" || code=$?
  else
    said="$(timeout 20 "$ENGINE" container inspect "$1" 2>&1 >/dev/null)" && return 0
    [[ "$said" == *"No such container"* ]] && return 1
    code=2
  fi
  case "$code" in 0|1) return "$code" ;; esac
  die "the engine did not say whether $1 is there"
}
# A container in one word: healthy, starting or unhealthy. One that runs and
# has no health check is healthy, which is what `upgrade` takes it for. Prints
# nothing when the engine does not say.
state_of(){ # <container>
  local s
  there "$1" || { echo unhealthy; return; }
  s="$(timeout 20 "$ENGINE" inspect --format '{{.State.Status}}/{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$1" 2>/dev/null)" || return 0
  case "$s" in
    running/|running/healthy) echo healthy ;;
    running/starting)         echo starting ;;
    ?*/*)                     echo unhealthy ;;
  esac
}
# Several of those as one: unhealthy if any is; else nothing if any is unknown;
# else starting if any is; else healthy.
worst_of(){ # <word>...
  local w unknown="" starting=""
  for w in "$@"; do
    case "$w" in
      unhealthy) echo unhealthy; return ;;
      starting)  starting=1 ;;
      healthy)   ;;
      *)         unknown=1 ;;
    esac
  done
  [[ -z "$unknown" ]] || return 0
  [[ -z "$starting" ]] || { echo starting; return; }
  echo healthy
}
# One of the platform's services, found by the labels compose gives its
# containers. A service without a container is not running; a listing can come
# back empty for a moment while containers are recreated, so an empty one is
# asked for once more before it counts.
platform_state(){ # <service>
  local names="" n again; local -a states=()
  for again in "" once; do
    names="$(timeout 20 "$ENGINE" ps -a --format '{{.Names}}' \
      --filter "label=com.docker.compose.project=${COMPOSE_PROJECT_NAME:-$(basename "$HERE")}" \
      --filter "label=com.docker.compose.service=$1" 2>/dev/null)" || return 0
    [[ -z "$names" && -z "$again" ]] || break
    sleep 2
  done
  [[ -n "$names" ]] || { echo unhealthy; return; }
  for n in $names; do states+=("$(state_of "$n")"); done
  worst_of "${states[@]}"
}
# The twelve characters `upgrade` prints for the image a container runs, also
# for a tenant that was promoted from a tag and has not been upgraded since.
image_of(){ # <container>
  local ref
  ref="$(timeout 20 "$ENGINE" inspect --format '{{.ImageName}}' "$1" 2>/dev/null)"
  [[ "$ref" == *@sha256:* ]] \
    || ref="$(timeout 20 "$ENGINE" image inspect --format '{{if .RepoDigests}}{{index .RepoDigests 0}}{{end}}' \
              "$(timeout 20 "$ENGINE" inspect --format '{{.Image}}' "$1" 2>/dev/null)" 2>/dev/null)"
  [[ "$ref" =~ @sha256:([0-9a-f]{12})[0-9a-f]{52}$ ]] && echo "${BASH_REMATCH[1]}"
  return 0
}
# When the certificate ends that this server hands out for a name, asked on
# its own loopback: what a browser is given, whatever the files say.
served_until(){ # <host>
  local answer end
  answer="$(timeout 5 openssl s_client -connect "127.0.0.1:${admin_at##*:}" -servername "$1" </dev/null 2>/dev/null)" || return 0
  openssl x509 -noout -checkhost "$1" <<<"$answer" 2>/dev/null | grep -qxF "Hostname $1 does match certificate" || return 0
  end="$(openssl x509 -noout -enddate -dateopt iso_8601 <<<"$answer" 2>/dev/null)"
  [[ "$end" =~ ^notAfter=(20[0-9]{2}-[0-9]{2}-[0-9]{2})\ ([0-9]{2}:[0-9]{2}:[0-9]{2})Z$ ]] \
    && echo "${BASH_REMATCH[1]}T${BASH_REMATCH[2]}Z"
  return 0
}
# A tenant's summary. What a container prints is taken for what it is: at most
# a megabyte is read, the one line that is a summary is rebuilt by summary.jq,
# and anything else gives nothing. The task is given 50 seconds where it runs,
# so that one that hangs does not stay behind in the container.
summary_of(){ # <codename>
  timeout -k 5 60 "$ENGINE" exec "castle-$1" timeout 50 castle-cli task --environment production summary 2>/dev/null \
    | head -c 1048576 \
    | jq -cnR -L "$HERE" 'include "summary";
        [inputs | fromjson? | select(type == "object" and has("summary_version"))]
        | select(length == 1) | .[0] | summary' 2>/dev/null
}
# true or false, or nothing where systemd does not answer.
timer_active(){ # <unit>
  case "$(timeout 10 systemctl is-active "$1" 2>/dev/null)" in
    active) echo true ;;
    inactive|failed|activating|deactivating) echo false ;;
  esac
}
# /run/reboot-required is left by a package's hook. Where no such hook is
# installed, its absence says nothing.
reboot_required(){
  if [[ -e /run/reboot-required ]]; then echo true
  elif [[ -e /etc/kernel/postinst.d/unattended-upgrades || -x /usr/share/update-notifier/notify-reboot-required ]]; then echo false
  fi
}
failed_units(){
  local out
  out="$(timeout 10 systemctl list-units --state=failed --no-legend --plain --no-pager 2>/dev/null)" || return 0
  grep -c . <<<"$out" || true
}
# How full the filesystem is that holds the containers' volumes, in percent.
disk_used(){
  local root used
  if [[ "$ENGINE" == *podman ]]; then root="$(timeout 20 "$ENGINE" info --format '{{.Store.GraphRoot}}' 2>/dev/null)"
  else root="$(timeout 20 "$ENGINE" info --format '{{.DockerRootDir}}' 2>/dev/null)"; fi
  [[ -n "$root" ]] || return 0
  used="$(timeout 10 df --output=pcent "$root" 2>/dev/null | tail -n 1)"
  [[ "$used" =~ ^\ *([0-9]{1,3})%$ ]] && echo "${BASH_REMATCH[1]}"
  return 0
}
newest_backup(){
  local newest
  newest="$(ls -1t "$BACKUP_DIR"/castle-backup-*.tar.age 2>/dev/null | head -n 1)"
  [[ -z "$newest" ]] || date -u -r "$newest" +%Y-%m-%dT%H:%M:%SZ
}
# The two questions that wait for an answer from outside castlectl's own
# reach, a tenant's summary and a served certificate, share one time for the
# run, so that many slow ones together stay within what the unit gives a run
# (systemd/castle-status.service). Past it they are not asked: their values
# are empty, and the run says how many.
STATUS_SECONDS="${STATUS_SECONDS:-120}"
in_time(){ (( SECONDS < STATUS_SECONDS )); }
# The lines status.jq makes the document from: `instance`, `platform` or
# `fact`, and then the values, separated by tabs. Only names of a codename's
# shape are asked about. A pool that cannot be read, or that has names and
# none of them a codename, is no pool to make a status of.
status_lines(){
  local cn kind health image ends summary service sign_in="" odd=0 unasked=0
  local -a names=()
  [[ -r "$POOL" ]] || die "the pool's names cannot be read ($POOL): no status"
  while IFS= read -r cn; do
    if [[ "$cn" =~ ^[a-z][a-z0-9-]{1,30}$ ]]; then names+=("$cn"); else odd=$((odd + 1)); fi
  done < <(pool_codenames)
  (( ${#names[@]} > 0 || odd == 0 )) || die "none of the $odd names in $POOL is a codename: no status"
  (( odd == 0 )) || echo "castlectl: the status leaves out $odd pool names that are not of a codename's shape" >&2
  SECONDS=0
  for cn in "${names[@]}"; do
    health=""; image=""; ends=""; summary=""
    if there "castle-$cn"; then
      kind=tenant
      health="$(worst_of "$(state_of "castle-$cn")" "$(state_of "postgres-$cn")" "$(state_of "oauth2-proxy-$cn")")"
      image="$(image_of "castle-$cn")"
      if in_time; then summary="$(summary_of "$cn")" || summary=""; else unasked=$((unasked + 1)); fi
    elif there "oauth2-proxy-$cn"; then
      kind=canary
      health="$(state_of "oauth2-proxy-$cn")"
    elif has_cert "$cn"; then
      kind=cert-only
    else
      continue
    fi
    if [[ "$kind" != cert-only ]]; then
      if in_time; then ends="$(served_until "$(host_of "$cn")")"; else unasked=$((unasked + 1)); fi
    fi
    printf 'instance\t%s\t%s\t%s\t%s\t%s\t%s\n' "$cn" "$kind" "$health" "$image" "$ends" "$summary"
  done
  if in_time; then sign_in="$(served_until "$KC_HOST")"; else unasked=$((unasked + 1)); fi
  (( unasked == 0 )) || echo "castlectl: the status ran out of its $STATUS_SECONDS seconds: $unasked summaries and certificates were not asked for and are null" >&2
  for service in caddy keycloak keycloak-db ${SELF_HOSTED_DNS:+dns}; do
    printf 'platform\t%s\t%s\n' "$service" "$(platform_state "$service")"
  done
  printf 'fact\t%s\t%s\n' \
    now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" sign_in "$sign_in" backup "$(newest_backup)" \
    reboot "$(reboot_required)" failed "$(failed_units)" disk "$(disk_used)" \
    renewal "$(timer_active castle-renew.timer)" backups "$(timer_active castle-backup.timer)"
}

status(){
  need jq; need openssl
  [[ "$STATUS_SECONDS" =~ ^[0-9]{1,3}$ ]] || die "STATUS_SECONDS is not a number of seconds"
  local lines made
  lines="$(status_lines)" || die "what runs here could not be read: no status"
  # Two lines: the document, and how much of what was gathered is not in it.
  made="$(jq -cnR -L "$HERE" 'include "status"; assembled | .document, .left_out' <<<"$lines")" \
    || die "could not put the status together"
  jq -r '(select(.names > 0) | "castlectl: the status leaves out \(.names) pool names: listed twice, or past the 500th"),
         (select(.summaries > 0) | "castlectl: the status leaves out \(.summaries) summaries, the largest, to stay within what the overview reads")' \
    <<<"${made##*$'\n'}" >&2
  printf '%s\n' "${made%%$'\n'*}"
}

# allocate = issue one cert + provision it as a canary (platform must be up).
allocate(){
  need_issuer; need_keycloak; need openssl; need_dns
  local cn; cn="$(next_codename)"; add_domain "$(host_of "$cn")"
  sync_certs; has_cert "$cn" || die "no certificate for '$cn': dehydrated failed"
  provision_canary "$cn"; reload_caddy
}

# --- self-hosted DNS commands ---------------------------------------------
# Generate the shared TSIG secret. Print it for .env (the `dns` service and
# castlectl both read DDNS_TSIG_SECRET from there — one secret, two consumers).
dns_init(){
  need openssl
  local secret; secret="$(openssl rand -base64 32)"
  cat <<EOF
Generated a DDNS TSIG secret. Add it to .env (used by the dns service AND castlectl):

  SELF_HOSTED_DNS=1
  PUBLIC_IP=<this VPS's public IP>
  DDNS_TSIG_SECRET=$secret

Then delegate $BASE_DOMAIN to this box (NS + glue) at your registrar, open :53,
and start the platform with the self-dns profile:

  $COMPOSE -f platform.compose.yml --profile self-dns up -d

Full walkthrough: docs/self-hosted-dns.md
EOF
}
# Reconcile the zone with reality: A record for every running codename, nothing
# for the rest. The runtime is the source of truth (same principle as `list`).
dns_sync(){
  [[ -n "$SELF_HOSTED_DNS" ]] || die "SELF_HOSTED_DNS is not set in .env"
  need nsupdate; ensure_tsig_keyfile
  local cn n=0
  for cn in $(pool_codenames); do
    if [[ -n "$(kind_of "$cn")" ]]; then dns_set_a "$cn"; n=$((n+1)); else dns_del_a "$cn"; fi
  done
  echo "dns synced: $n running codename(s) -> $PUBLIC_IP; dark codenames withdrawn"
}

# --- upgrade ---------------------------------------------------------------
# up -d returns once a container is CREATED, not once the app inside is serving —
# a crash-loop or a failed migration would otherwise pass as "deployed". Poll the
# container until its healthcheck goes healthy (a tenant's castle has one — see the
# tenant template); a canary's oauth2-proxy has none, so just confirm it stayed up.
# Returns nonzero on unhealthy / exited / timeout. (podman-compose has no
# `up --wait`, so poll rather than rely on compose to block.)
wait_healthy(){ # <container> <mode: health|running> [<timeout-seconds>]
  local c="$1" mode="$2" timeout="${3:-${UPGRADE_HEALTH_TIMEOUT:-120}}" waited=0 status health
  while :; do
    status="$($ENGINE inspect --format '{{.State.Status}}' "$c" 2>/dev/null)"
    case "$status" in
      exited|died|removing) return 1 ;;                 # crashed out / gone
    esac
    if [[ "$mode" == running ]]; then
      [[ "$status" == running ]] && return 0
    elif [[ "$status" == running ]]; then
      # .State.Health.Status exists only when a healthcheck is defined.
      health="$($ENGINE inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$c" 2>/dev/null)"
      [[ "$health" == healthy ]]   && return 0
      [[ "$health" == unhealthy ]] && return 1
    fi
    (( waited >= timeout )) && return 1
    sleep 3; waited=$((waited + 3))
  done
}

# Recreate running instances with the current images (CASTLE_IMAGE / templates)
# and rewrite their edge vhosts, keeping their data volumes. castle runs pending
# schema migrations on boot (auto_migrate), so an app upgrade is: bump
# CASTLE_IMAGE in .env, then this.
upgrade(){ # [<codename>]  (default: every running codename)
  need_keycloak; need openssl
  local one="${1:-}" targets=() cn
  if [[ -n "$one" ]]; then
    [[ -n "$(kind_of "$one")" ]] || die "'$one' is not running"
    targets=("$one")
  else
    for cn in $(pool_codenames); do [[ -n "$(kind_of "$cn")" ]] && targets+=("$cn"); done
  fi
  [[ ${#targets[@]} -gt 0 ]] || { echo "nothing running to upgrade"; return 0; }
  echo "upgrading ${#targets[@]} instance(s): ${targets[*]}"

  # Resolve the tenant app image to its immutable digest ONCE, before the loop, so
  # every tenant in this batch is pinned to the SAME build — a tag like :main that
  # moves mid-run can't split the fleet across two images. Only needed if a tenant
  # is in scope (canaries carry their own fixed proxy image, no __IMAGE__). A
  # failed pull/resolve is fatal UP FRONT (nothing has been touched yet): shipping a
  # stale image is exactly how a moved :main looks "deployed" while the old
  # container keeps running.
  local app_img="" has_tenant=0
  for cn in "${targets[@]}"; do [[ "$(kind_of "$cn")" == tenant ]] && { has_tenant=1; break; }; done
  if (( has_tenant )); then
    check_logo
    run_or_die "pull failed for $CASTLE_IMAGE" "$ENGINE" pull "$CASTLE_IMAGE"
    app_img="$(resolve_digest "$CASTLE_IMAGE")"
    [[ "$app_img" == *@sha256:* ]] || die "could not resolve a digest for $CASTLE_IMAGE (is it pulled?)"
    # A digest in CASTLE_IMAGE is deliberate for a rollback, so this is a notice
    # and not a refusal — but it deploys exactly that build and can never pick up
    # a newer one, which is worth saying out loud every time.
    if [[ "$CASTLE_IMAGE" == *@sha256:* ]]; then
      echo "  note: CASTLE_IMAGE is pinned to $(short_ref "$CASTLE_IMAGE") and cannot move."
      echo "        Set it to a tag (e.g. ghcr.io/sp0q1/castle:main) to track main again."
    fi
  fi

  # Each instance's realm is brought up to date in its turn, and Keycloak takes
  # a minute to answer after the platform's own upgrade recreated it. Without
  # Keycloak the instances are still upgraded, and the summary names the realms.
  realm_sh await || echo "  Keycloak does not answer at $KC_ADMIN_URL: the realms' clients stay as they are" >&2

  # One bad instance must NOT abort the fleet or skip reload_caddy: collect the
  # failures, keep going, then summarize and exit nonzero at the end if any failed.
  local -a fails=()
  local kind target hc out before
  for cn in "${targets[@]}"; do
    kind="$(kind_of "$cn")"
    if [[ "$kind" == tenant ]]; then
      render_instance "$cn" "$TPL/tenant.compose.yml" "$app_img"; target="castle-$cn"; hc=health
      before="$(running_ref "$target")"
    else
      render_instance "$cn" "$TPL/canary.compose.yml";            target="oauth2-proxy-$cn"; hc=running
      before=""
    fi
    write_site "$cn"
    if ! out="$(compose_instance "$cn" pull 2>&1)"; then
      fails+=("$cn ($kind): image pull failed — ${out##*"$NL"}"); continue
    fi
    if ! out="$(compose_instance "$cn" up -d 2>&1)"; then
      fails+=("$cn ($kind): up -d failed — ${out##*"$NL"}"); continue
    fi
    # up -d only created the container; verify the app actually came up.
    if wait_healthy "$target" "$hc"; then
      if [[ "$kind" == tenant && "$before" == "$app_img" ]]; then
        echo "  $cn ($kind) already on $(short_ref "$app_img") — image unchanged"
      elif [[ "$kind" == tenant && -n "$before" ]]; then
        echo "  $cn ($kind) $(short_ref "$before") -> $(short_ref "$app_img") (data kept)"
      else
        echo "  $cn ($kind) recreated with current image (data kept)"
      fi
      # The proxy now runs as the templates have it. Its realm's clients are
      # brought to what `keycloak-realm.sh create` leaves today, after the
      # proxy and never before it, so a requirement only ever reaches a realm
      # whose proxy already meets it. Tenant and canary alike.
      out="$(KC_URL="$KC_ADMIN_URL" KC_REALM_PREFIX="$KC_REALM_PREFIX" BASE_DOMAIN="$BASE_DOMAIN" EXTERNAL_PORT="$EXTERNAL_PORT" \
        "$REALM_SH" update "$cn" 2>&1)" \
        || fails+=("$cn ($kind): its realm could not be brought up to date — ${out##*"$NL"}")
    else
      fails+=("$cn ($kind): $target not healthy after up -d (see: $ENGINE logs $target)")
    fi
  done
  reload_caddy
  batch_result upgrade "${#targets[@]}" "${fails[@]}" || exit 1
  echo "migrations apply on boot (auto_migrate)."
}

# --- backup / restore ------------------------------------------------------
# Logical, portable, encrypted backups. Complements VPS snapshots by being
# per-tenant, off-box and pg-version-independent — and by bundling each tenant's
# DB *with its secrets and cert*, so a restore can never orphan the data.
platform_exec(){ $COMPOSE -f platform.compose.yml exec -T "$@"; }

# Off-box copy (optional). BACKUP_PUSH_CMD runs once per bundle; {} expands to
# its path (otherwise the path is appended), so any transport works:
#   BACKUP_PUSH_CMD='rclone copy {} b2:castle-backups/'
#   BACKUP_PUSH_CMD='rsync -a {} backups@vault:/srv/castle/'
push_bundle(){ # <bundle>
  [[ -n "$BACKUP_PUSH_CMD" ]] || return 0
  local out="$1" push="$BACKUP_PUSH_CMD"
  case "$push" in *'{}'*) push="${push//\{\}/$out}" ;; *) push="$push \"$out\"" ;; esac
  echo "off-box copy"
  eval "$push" || die "BACKUP_PUSH_CMD failed (bundle kept locally at $out)"
}

backup(){
  [[ -n "$BACKUP_AGE_RECIPIENT" ]] || die "set BACKUP_AGE_RECIPIENT (age public key) in .env — refusing to write an unencrypted backup of secrets + client data"
  need age; need "$ENGINE"; need tar
  bundle_lock
  local ts work out cn
  ts="$(date +%Y%m%d-%H%M%S)"
  workdir work
  echo "backup: platform + tenants -> encrypted bundle"
  # Platform: Keycloak realms/users, plus the re-derivable-only state (all
  # per-codename secrets, the whole pre-issued cert pool, the dehydrated account,
  # and .env). --clean makes the dump loadable over an existing DB on restore.
  mkdir -p "$work/platform"
  platform_exec keycloak-db pg_dump --clean --if-exists -U keycloak -d keycloak > "$work/platform/keycloak.sql" \
    || die "keycloak pg_dump failed (is the platform up?)"
  [[ -f .env ]] && cp -a .env "$work/platform/env"
  [[ -d "$RUN"   ]] && cp -a "$RUN"   "$work/instances"
  [[ -d "$CERTS" ]] && { mkdir -p "$work/certs"; cp -a "$CERTS/." "$work/certs/"; }
  [[ -d "$HERE/dehydrated" ]] && cp -a "$HERE/dehydrated" "$work/dehydrated"
  # Per tenant: logical DB dump (portable across pg versions) + uploads. One
  # unhealthy tenant must NOT abort the whole run — record and continue. Uploads
  # are part of the tenant's data, so a failed tar is a recorded failure too, not
  # a silent `|| true` that ships an incomplete bundle while printing success.
  # (`2>&1 >file`: dump/tarball go to the file, only stderr is captured for the
  # cause.)
  local -a bfails=()
  local tcount=0 derr uerr
  for cn in $(pool_codenames); do
    [[ "$(kind_of "$cn")" == tenant ]] || continue
    tcount=$((tcount + 1))
    mkdir -p "$work/tenants/$cn"
    if ! derr="$($ENGINE exec "postgres-$cn" pg_dump --clean --if-exists -U castle -d castle 2>&1 > "$work/tenants/$cn/db.sql")"; then
      bfails+=("tenant $cn: pg_dump failed — ${derr##*"$NL"}"); continue
    fi
    if ! uerr="$($ENGINE run --rm -v "$(proj_of "$cn")_castle_uploads:/data:ro" "$UTIL_IMAGE" tar cf - -C /data . 2>&1 > "$work/tenants/$cn/uploads.tar")"; then
      bfails+=("tenant $cn: uploads tar failed — ${uerr##*"$NL"}"); continue
    fi
    echo "  tenant $cn: db + uploads"
  done
  out="$BACKUP_DIR/castle-backup-$ts.tar.age"
  # A bundle has its name once it is complete and on the disk. Until then it
  # is a `.part` beside it, which nothing takes for a bundle, and which goes
  # when writing fails or the next backup or export starts.
  ( cd "$work" && tar cf - . ) | age -r "$BACKUP_AGE_RECIPIENT" > "$out.part" && sync "$out.part" && mv "$out.part" "$out" \
    || { rm -f "$out.part"; die "encrypt failed"; }
  sync "$BACKUP_DIR" 2>/dev/null || true
  echo "wrote $out ($(du -h "$out" | cut -f1)) — decrypt needs your offline age identity."

  push_bundle "$out"

  # Retention: keep the newest $BACKUP_KEEP bundles locally — they're
  # age-encrypted, so pruning old local copies is safe once they're off-box.
  if [[ "$BACKUP_KEEP" =~ ^[0-9]+$ ]] && (( BACKUP_KEEP > 0 )); then
    ls -1t "$BACKUP_DIR"/castle-backup-*.tar.age 2>/dev/null | tail -n +"$((BACKUP_KEEP + 1))" \
      | while read -r old; do rm -f "$old" && echo "  pruned $(basename "$old")"; done
  fi

  # The bundle was written (and pushed/pruned) so the tenants that DID dump are
  # safe, but if any tenant was incomplete, exit nonzero — a cron/timer run must
  # not look clean when a tenant's data is missing.
  batch_result backup "$tcount" "${bfails[@]}" || return 1
}

# Restore is idempotent and safe to re-run: it restores the files, then loads the
# DBs into whichever stacks are currently up (stopping the app for each load so it
# isn't mutating the DB mid-restore). On a fresh box: restore -> bring up platform
# -> provision-pool -> restore again to load the tenant DBs.
restore(){ # <backup-file> [--yes]
  local file="${1:-}" yes="${2:-}"
  [[ -n "$file" && -f "$file" ]] || die "usage: castlectl restore <backup-file> [--yes]"
  [[ -n "$BACKUP_AGE_IDENTITY" ]] || die "set BACKUP_AGE_IDENTITY (age identity file) to decrypt"
  [[ "$yes" == "--yes" ]] || die "restore overwrites secrets/certs and loads DBs — re-run with --yes to confirm"
  need age; need "$ENGINE"; need tar
  local work cn
  local -a rfails=()
  local attempted=0 realms="" kerr terr uerr
  workdir work
  echo "restore: decrypting $file"
  age -d -i "$BACKUP_AGE_IDENTITY" < "$file" | ( cd "$work" && tar xf - ) || die "decrypt/extract failed"

  # 1) Files first, so any stack that comes up afterwards uses the right secrets.
  [[ -d "$work/instances" ]] && { mkdir -p "$RUN"; cp -a "$work/instances/." "$RUN/"; echo "  restored per-codename secrets"; }
  [[ -d "$work/certs" ]] && { mkdir -p "$CERTS"; cp -a "$work/certs/." "$CERTS/"; echo "  restored cert pool"; }
  [[ -d "$work/dehydrated" ]] && { cp -a "$work/dehydrated/." "$HERE/dehydrated/"; echo "  restored dehydrated account"; }
  if [[ -f "$work/platform/env" ]]; then
    [[ -f .env ]] && echo "  .env already present — left as-is (backup copy at $work is discarded)" \
                  || { cp -a "$work/platform/env" .env; echo "  restored .env"; }
  fi

  # 2) Keycloak realms/users — stop keycloak so the load isn't fighting it.
  if [[ -f "$work/platform/keycloak.sql" ]] && platform_exec keycloak-db pg_isready -U keycloak >/dev/null 2>&1; then
    attempted=$((attempted + 1))
    $COMPOSE -f platform.compose.yml stop keycloak >/dev/null 2>&1 || true
    # ON_ERROR_STOP=1: without it psql exits 0 even when every statement failed,
    # and a broken load would report success. The dump is
    # --clean --if-exists, so re-loading over an existing DB drops cleanly first.
    # `2>&1 >/dev/null` keeps stderr (the cause) and drops psql's normal chatter.
    if kerr="$(platform_exec keycloak-db psql -v ON_ERROR_STOP=1 -U keycloak -d keycloak < "$work/platform/keycloak.sql" 2>&1 >/dev/null)"; then
      echo "  loaded keycloak realms/users"; realms=1
    else
      rfails+=("keycloak: load failed — ${kerr##*"$NL"}")
    fi
    $COMPOSE -f platform.compose.yml start keycloak >/dev/null 2>&1 || true
  elif [[ -f "$work/platform/keycloak.sql" ]]; then
    echo "  keycloak-db not up — bring the platform up, then re-run restore." >&2
  fi

  # 3) Tenant DBs + uploads — stop each castle app for its DB load. Errors are
  # recorded (not printed to stdout as if benign) so the pass can exit nonzero.
  for cn in "$work"/tenants/*/; do
    [[ -d "$cn" ]] || continue; cn="$(basename "$cn")"
    if $ENGINE exec "postgres-$cn" pg_isready -U castle >/dev/null 2>&1; then
      attempted=$((attempted + 1))
      compose_instance "$cn" stop castle >/dev/null 2>&1 || true
      # ON_ERROR_STOP=1 so a failed statement makes psql exit nonzero (see keycloak).
      if terr="$($ENGINE exec -i "postgres-$cn" psql -v ON_ERROR_STOP=1 -U castle -d castle < "$work/tenants/$cn/db.sql" 2>&1 >/dev/null)"; then
        echo "  tenant $cn: DB loaded"
      else
        rfails+=("tenant $cn: DB load failed — ${terr##*"$NL"}")
      fi
      if [[ -s "$work/tenants/$cn/uploads.tar" ]]; then
        if uerr="$($ENGINE run --rm -i -v "$(proj_of "$cn")_castle_uploads:/data" "$UTIL_IMAGE" sh -c 'cd /data && tar xf -' < "$work/tenants/$cn/uploads.tar" 2>&1)"; then
          echo "  tenant $cn: uploads restored"
        else
          rfails+=("tenant $cn: uploads restore failed — ${uerr##*"$NL"}")
        fi
      fi
      compose_instance "$cn" start castle >/dev/null 2>&1 || true
    else
      echo "  tenant $cn not up — run 'castlectl provision-pool' and 'castlectl promote $cn', then re-run restore." >&2
    fi
  done
  # A pass where nothing was reachable (attempted=0) is fine — the multi-pass flow
  # expects it. Fail only when something we DID try to load errored.
  batch_result restore "$attempted" "${rfails[@]}" || return 1
  echo "restore pass complete."
  [[ -z "$realms" ]] || echo "Keycloak's realms are as the bundle has them: 'castlectl upgrade' brings their clients to this release."
}

# --- one tenant, portable --------------------------------------------------
# A tenant bundle holds one client's database, uploads and people (who they are
# and their groups, no credentials), encrypted like a backup. It is what brings
# a client up under another codename or on another host.
realm_sh(){ KC_URL="$KC_ADMIN_URL" KC_REALM_PREFIX="$KC_REALM_PREFIX" "$REALM_SH" "$@"; }

export_tenant(){ # <codename>
  local cn="${1:?export needs a <codename>}" ts work out err
  [[ "$(kind_of "$cn")" == tenant ]] || die "'$cn' is not a tenant"
  [[ -n "$BACKUP_AGE_RECIPIENT" ]] || die "set BACKUP_AGE_RECIPIENT (age public key) in .env — refusing to write an unencrypted export"
  need_export
  bundle_lock
  ts="$(date +%Y%m%d-%H%M%S)"
  workdir work
  err="$($ENGINE exec "postgres-$cn" pg_dump --clean --if-exists -U castle -d castle 2>&1 > "$work/db.sql")" \
    || die "pg_dump failed for $cn — ${err##*"$NL"}"
  err="$($ENGINE run --rm -v "$(proj_of "$cn")_castle_uploads:/data:ro" "$UTIL_IMAGE" tar cf - -C /data . 2>&1 > "$work/uploads.tar")" \
    || die "uploads tar failed for $cn — ${err##*"$NL"}"
  realm_sh people "$cn" > "$work/people.json" || die "could not list the people of '$cn'"
  out="$BACKUP_DIR/castle-tenant-$cn-$ts.tar.age"
  ( cd "$work" && tar cf - db.sql uploads.tar people.json ) | age -r "$BACKUP_AGE_RECIPIENT" > "$out.part" && sync "$out.part" && mv "$out.part" "$out" \
    || { rm -f "$out.part"; die "encrypt failed"; }
  sync "$BACKUP_DIR" 2>/dev/null || true
  echo "exported '$cn' ($(jq length "$work/people.json") people) -> $out ($(du -h "$out" | cut -f1))"
  push_bundle "$out"
}

# One of castle's own tasks, in a tenant's running castle. Without a task name
# it lists them.
castle_task(){ # <codename> [<task> [args...]]
  local cn="$1"; shift
  "$ENGINE" exec "castle-$cn" castle-cli task --environment production "$@"
}

import_tenant(){ # <tenant-bundle> <codename>
  local file="${1:-}" cn="${2:-}" work err
  [[ -n "$file" && -f "$file" && -n "$cn" ]] || die "usage: castlectl import <tenant-bundle> <codename>"
  [[ -n "$BACKUP_AGE_IDENTITY" ]] || die "set BACKUP_AGE_IDENTITY (age identity file) to decrypt"
  [[ "$(kind_of "$cn")" == canary ]] || die "'$cn' is not a canary — a tenant bundle goes into a codename that is not in use"
  need age; need_keycloak; need openssl; need "$ENGINE"; need tar
  workdir work
  age -d -i "$BACKUP_AGE_IDENTITY" < "$file" | ( cd "$work" && tar xf - ) || die "decrypt/extract failed"
  [[ -f "$work/db.sql" && -f "$work/uploads.tar" ]] && jq -e 'type == "array"' "$work/people.json" >/dev/null 2>&1 \
    || die "$file is not a tenant bundle"

  promote "$cn"
  wait_healthy "castle-$cn" health || die "castle-$cn did not come up (see: $ENGINE logs castle-$cn)"
  compose_instance "$cn" stop castle >/dev/null 2>&1
  err="$($ENGINE exec -i "postgres-$cn" psql -v ON_ERROR_STOP=1 -U castle -d castle < "$work/db.sql" 2>&1 >/dev/null)" \
    || die "database load failed — ${err##*"$NL"} ('$cn' is left half-loaded: demote it with --no-export and import again)"
  err="$($ENGINE run --rm -i -v "$(proj_of "$cn")_castle_uploads:/data" "$UTIL_IMAGE" sh -c 'cd /data && tar xf -' < "$work/uploads.tar" 2>&1)" \
    || die "uploads load failed — ${err##*"$NL"} ('$cn' is left half-loaded: demote it with --no-export and import again)"
  compose_instance "$cn" start castle >/dev/null 2>&1
  wait_healthy "castle-$cn" health || die "castle-$cn did not come back (see: $ENGINE logs castle-$cn)"
  # The accounts came bound to the people of the realm they left. Here everyone
  # is made anew and has a new id, so each account is let go, to be taken by
  # whoever this realm vouches for with its address. A castle from before
  # accounts were bound has no such task, and nothing to let go.
  if castle_task "$cn" 2>/dev/null | grep -q '^user:unbind'; then
    err="$(castle_task "$cn" user:unbind all:yes 2>&1)" \
      || die "the data is in place but the accounts are still bound to the people of the old realm — ${err##*"$NL"}"
  fi
  echo "  data loaded; adding the people to realm $(realm_of "$cn")"
  realm_sh add-people "$cn" < "$work/people.json" || die "the data is in place but not everyone could be added to the realm"
  echo "imported into '$cn'. Nobody has a password yet: give each person one in Keycloak before they sign in."
}

users(){ # <codename>
  local cn="${1:?users needs a <codename>}"
  [[ -n "$(kind_of "$cn")" ]] || die "'$cn' is not running"
  need_keycloak
  realm_sh people "$cn" | jq -r '
    ["EMAIL", "NAME", "ROLE", "ENABLED"],
    (sort_by(.email)[] | [
      (.email // .username),
      ([.firstName, .lastName] | map(select(. != null)) | join(" ")),
      (if (.groups | index("castle-managers")) then "manager" elif (.groups | index("castle-staff")) then "staff"
       elif (.groups | index("castle-clients")) then "client" else "none" end),
      (if .enabled then "yes" else "no" end)
    ]) | @tsv' | awk -F '\t' '{ printf "%-36s %-24s %-8s %s\n", $1, $2, $3, $4 }'
}

# Gives castlectl an account of its own at Keycloak, so that from here on it
# asks with that account's secret and no administrator's password has to stay
# in .env. An administrator signs in once to make it: KC_ADMIN_USER and
# KC_ADMIN_PASS, from .env or the environment of this one run. Running it again
# brings the account back to this state with the secret it has.
keycloak_setup(){
  need_keycloak; need openssl
  local secret out
  [[ -n "${KC_ADMIN_USER:-}" && -n "${KC_ADMIN_PASS:-}" ]] \
    || die "keycloak-setup signs in as an administrator once: give KC_ADMIN_USER and KC_ADMIN_PASS for this run"
  if [[ -s "$KC_SERVICE" ]]; then secret="$(cat "$KC_SERVICE")"; else secret="$(openssl rand -hex 32)"; fi
  out="$(env -u KC_CLIENT_SECRET SERVICE_SECRET="$secret" KC_URL="$KC_ADMIN_URL" "$REALM_SH" service-account 2>&1)" \
    || die "could not set up the service account:"$'\n'"$out"
  printf '%s' "$secret" > "$KC_SERVICE"
  echo "castlectl has its own account at Keycloak now ($(basename "$KC_SERVICE"), in .instances/)."
  echo "The master realm locks out after failed sign-ins. The first administrator's"
  echo "password is no longer needed here: see docs/admin-rotation.md."
}

cmd="${1:-}"; shift || true
case "$cmd" in
  issue-certs)     issue_certs "${1:-10}" ;;
  keycloak-setup)  keycloak_setup ;;
  provision-pool)  provision_pool ;;
  renew-pool)      renew_pool ;;
  allocate)        allocate ;;
  promote)         promote "${1:-}" ;;
  demote)          demote "$@" ;;
  export)          export_tenant "${1:-}" ;;
  import)          import_tenant "${1:-}" "${2:-}" ;;
  users)           users "${1:-}" ;;
  deprovision)     deprovision "${1:-}" ;;
  list)            list ;;
  status)          status ;;
  dns-init)        dns_init ;;
  dns-sync)        dns_sync ;;
  upgrade)         upgrade "${1:-}" ;;
  backup)          backup ;;
  restore)         restore "${1:-}" "${2:-}" ;;
  *) cat >&2 <<'USAGE'
usage: castlectl <command>
  issue-certs [N]        issue certs for N more codenames (one CA batch)
  provision-pool         stand up a canary for every codename that has a cert
  allocate               pick a free codename, issue its cert, canary it
  promote <cn>           turn a canary into a tenant (cert and subdomain unchanged)
  demote <cn> --yes      turn a tenant back into a canary: exports it, then destroys its
                         data, people and secrets (--no-export skips the export)
  export <cn>            write one tenant's data and people as an encrypted bundle
  import <file> <cn>     load a tenant bundle into a canary, which becomes that tenant
  users <cn>             list the people in a codename's realm and their roles
  keycloak-setup         give castlectl an account of its own at Keycloak
  deprovision <cn>       tear an instance down (cert kept)
  renew-pool             renew the pool's certs that are due, in one run
  list                   show codenames and their state
  status                 print how this server is, as JSON for the overview
  upgrade [<cn>]         recreate running instance(s) with current images (keeps data)
  backup                 write an age-encrypted bundle (DBs + secrets + certs)
  restore <file> --yes   restore from a bundle
  dns-init | dns-sync    self-hosted DNS: init the TSIG secret / reconcile A records
USAGE
     exit 1 ;;
esac
